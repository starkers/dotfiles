# vi:set ft=ini

font-family = "ComicCode Nerd Font"

term = xterm

window-decoration = false


# See:  https://ghostty.org/docs/config/keybind
#
# ghostty  +list-keybinds
#   or
# ghostty  +list-keybinds --default

#keybind = ctrl+h=goto_split:left
#keybind = ctrl+j=goto_split:bottom
#keybind = ctrl+k=goto_split:top
#keybind = ctrl+l=goto_split:right

keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right

keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+o=new_split:down

keybind = ctrl+shift+x=toggle_split_zoom
keybind = ctrl+shift+i=unbind

keybind = ctrl+shift+k=resize_split:up,10
keybind = ctrl+shift+j=resize_split:down,10
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+l=resize_split:right,10


# # molokai
# background             = #1b1d1e
# foreground             = #f8f8f2
# cursor-color           = #f8f8f0
# cursor-text            = #1b1d1e
# selection-background   = #49483e
# selection-foreground   = #f8f8f2
#
# background-opacity     = 0.97
unfocused-split-opacity = 0.55
split-divider-color    = #a6e22e

